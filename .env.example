# Copy to .env.local (or set these in Replit's Secrets pane) to switch each
# integration from mock mode to live. Every integration below works with zero
# keys set -- the app runs entirely on seeded/mock data until you add them.

# --- Supabase (Postgres + Auth) ---
# Without ALL THREE of these, the app uses an in-memory mock repository seeded with
# demo data, AND real login is skipped entirely (every request resolves to the seeded
# demo student -- see lib/viewer.ts). With them set, real auth is required: middleware.ts
# redirects signed-out visitors to /login, and admins/CFIs invite real accounts via
# /admin/students /admin/instructors (see lib/auth/invite.ts). The anon key specifically
# is what makes sign-in/sign-up/invite-acceptance work (lib/supabase/client.ts) -- it's
# not just a formality alongside the service-role key anymore.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flightradar24 (flight data) ---
# Without this, tail-number search returns generated mock candidate flights + tracks.
FR24_API_KEY=

# --- Deepgram (speech-to-text) ---
# Without this, the debrief screen plays back a canned transcript instead of live mic STT.
# Note: this is a browser-exposed key (Deepgram's documented client-side streaming pattern).
# For a production deployment, mint short-lived scoped keys server-side instead.
NEXT_PUBLIC_DEEPGRAM_API_KEY=

# --- Deepgram (text-to-speech) ---
# Without this, the "Listen to your brief/debrief" buttons don't appear.
# Server-only key (unlike the streaming key above) -- Flux TTS is a plain REST call from
# lib/deepgram-tts.ts, never exposed to the browser. Voice choice (Hannah/Kit/Alexis/Cole)
# is picked per-user in the UI (see lib/tts-voices.ts), not configured here.
DEEPGRAM_API_KEY=

# --- Anthropic (Claude debrief analysis) ---
# Without this, debrief analysis uses a deterministic local heuristic analyzer instead of Claude.
ANTHROPIC_API_KEY=

# --- Mapbox (flight track map) ---
# Without this, the flight detail screen shows a simple placeholder instead of a live map.
NEXT_PUBLIC_MAPBOX_TOKEN=
