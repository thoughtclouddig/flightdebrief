# Copy to .env.local (or set these in Replit's Secrets pane) to switch each
# integration from mock mode to live. Every integration below works with zero
# keys set -- the app runs entirely on seeded/mock data until you add them.

# --- Authentication (email magic links) ---
# Passwordless sign-in: users get a short-lived signed link by email (Resend).
# Needs SESSION_SECRET (JWT signing) and DATABASE_URL for the identity tables
# (see lib/auth/*). Login is always required for (product) routes.
SESSION_SECRET=
# Email sending: RESEND_API_KEY is preferred; without it the workspace's
# Resend connection is used. INVITE_EMAIL_FROM must be a Resend-verified
# sender (defaults to the shared test sender). APP_BASE_URL overrides the
# origin used in emailed links.
RESEND_API_KEY=
INVITE_EMAIL_FROM=
APP_BASE_URL=

# --- Demo data seeding (opt-in) ---
# Set to 1/true to seed the Falcon Aviation demo dataset (sample flights,
# debriefs, reservations, training data) into an empty database on first use.
# Never runs inside a production deployment (REPLIT_DEPLOYMENT). Leave unset
# for a clean start with no sample flights.
SEED_DEMO_DATA=

# --- Supabase (optional data repository only) ---
# Auth no longer uses Supabase. If BOTH of these are unset, flight/roster data
# comes from the in-memory mock repository seeded with demo data. Set them to
# use the Supabase-backed data repository (lib/data/supabase-repository.ts).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flightradar24 (flight data) ---
# Without this, tail-number search returns generated mock candidate flights + tracks.
FR24_API_KEY=

# --- Deepgram (speech-to-text) ---
# Without this, the debrief screen plays back a canned transcript instead of live mic STT.
# Note: this is a browser-exposed key (Deepgram's documented client-side streaming pattern).
# For a production deployment, mint short-lived scoped keys server-side instead.
NEXT_PUBLIC_DEEPGRAM_API_KEY=

# --- Deepgram (text-to-speech) ---
# Without this, the "Listen to your brief/debrief" buttons don't appear.
# Server-only key (unlike the streaming key above) -- Flux TTS is a plain REST call from
# lib/deepgram-tts.ts, never exposed to the browser. Voice choice (Hannah/Kit/Alexis/Cole)
# is picked per-user in the UI (see lib/tts-voices.ts), not configured here.
DEEPGRAM_API_KEY=

# --- Anthropic (Claude debrief analysis) ---
# Without this, debrief analysis uses a deterministic local heuristic analyzer instead of Claude.
ANTHROPIC_API_KEY=

# --- Mapbox (flight track map) ---
# Without this, the flight detail screen shows a simple placeholder instead of a live map.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- OpenAI (article hero images) ---
# Without this, the daily content pipeline still generates the article text but
# leaves image_url null -- no image, not a placeholder.
OPENAI_API_KEY=

# --- Content pipeline (daily AI article generation) ---
# Shared secret for the scheduled/external caller of
# POST /api/admin/content/generate-daily (see that route) so it doesn't need
# an admin login. An admin's own session works too, via the "Generate Draft
# Now" button in /admin/articles. Every generated article lands as a draft --
# nothing publishes itself. Set up the daily schedule as a Replit Scheduled
# Deployment that runs: curl -X POST $APP_BASE_URL/api/admin/content/generate-daily -H "Authorization: Bearer $CONTENT_PIPELINE_SECRET"
CONTENT_PIPELINE_SECRET=

# --- Company superadmin ---
# Comma-separated emails allowed into /super-admin (platform-wide view across
# every organization/subscriber) and treated as an admin in /admin/articles +
# /admin/research regardless of their org role. Unset means no one has this
# access -- it is not derived from any org's admin role.
SUPERADMIN_EMAILS=

# Set to "true" to opt debrief transcription BACK IN to Deepgram's Model
# Improvement Program, which restores their 50% discount but lets Deepgram
# retain and train on submitted audio. Left unset (the default) the app opts
# out, which is what /data-handling and /how-it-works promise school owners.
# If you set this, correct those two pages first.
NEXT_PUBLIC_DEEPGRAM_ALLOW_MIP=
